# ==============================================================================
# HealthTech Learning Platform - Environment Configuration Template (Week 6)
# ==============================================================================

# --- Django Core Configuration ---
DJANGO_SECRET_KEY=replace-with-a-secure-random-64-character-production-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend

# --- Database Connection (PostgreSQL) ---
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/healthtech_db
POSTGRES_DB=healthtech_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Security & Cookies ---
# Set to True in production with valid HTTPS/SSL certificates
JWT_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# --- LLM & External Services ---
# Optional: Google Gemini API key for live LLM RAG assistant (falls back gracefully to synthetic citations if blank)
GEMINI_API_KEY=your_gemini_api_key_here

# --- Frontend Next.js Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:8000
PORT=3000
